[Unit]
Description=Traefik reverse proxy
After=network-online.target
#Requires=podman.socket http.socket https.socket step-ca.service
Requires=podman.socket step-ca.service

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15
StartLimitBurst=5
StartLimitIntervalSec=120
Accept=no

[Container]
ContainerName=traefik
Image=docker.io/library/traefik:v3.5
PodmanArgs=--privileged
Exec=--configFile=/etc/traefik/traefik.yaml
Environment="LEGO_CA_CERTIFICATES=/certs/root_ca.crt"
AutoUpdate=registry
Volume=/run/user/%U/podman/podman.sock:/var/run/docker.sock:ro,z
Volume=%h/.config/containers/traefik/conf.d:/etc/traefik/conf.d:ro
Volume=%h/.config/containers/traefik/traefik.yaml:/etc/traefik/traefik.yaml:ro
Volume=step-ca-certs.volume:/certs:ro,z
PublishPort=80:80
PublishPort=443:443
Network=public.network
Label=traefik.enable=true
# region dashboard
Label=traefik.http.routers.dashboard.rule=Host(`traefik.x.home.arpa`) && (PathPrefix(`/api`) || PathPrefix(`/dashboard`) || PathPrefix(`/dashboard/`))
Label=traefik.http.routers.dashboard.entrypoints=websecure
Label=traefik.http.routers.dashboard.service=api@internal
Label=traefik.http.routers.dashboard.tls.certresolver=ca
Label=traefik.http.routers.dashboard.middlewares=auth
Label=traefik.http.middlewares.auth.basicauth.users=risus:$$apr1$$Qhuh9sKg$$bhKbVV.XLZ2Ycegt/3zeL1
# endregion dashboard
