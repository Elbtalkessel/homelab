[Unit]
Description=Plex Server

[Install]
WantedBy=default.target

[Container]
Image=docker.io/plexinc/pms-docker:latest
AutoUpdate=registry
ContainerName=plex
Volume=plex-config.volume:/config
Volume=/var/mnt/s1/media:/share/Video
Environment="PLEX_UID=0"
Environment="PLEX_GID=0"
Environment="TZ=Etc/UTC"
Environment="VERSION=docker"
Network=host
