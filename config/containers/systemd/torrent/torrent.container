[Unit]
Description=qBitTorrent
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=lscr.io/linuxserver/qbittorrent:latest
AutoUpdate=registry
ContainerName=torrent

Environment=TZ=Etc/UTC
Environment=QBITTORRENT_VERSION=5.2.0
Environment=TP_COMMUNITY_THEME=true
Environment=TP_THEME=catppuccin-frappe
Environment=DOCKER_MODS=ghcr.io/themepark-dev/theme.park:qbittorrent
Environment=WEBUI_PORT=8080
Environment=TORRENTING_PORT=6881
Environment=PUID=0
Environment=PGID=0

HealthCmd=CMD-SHELL bash /usr/local/bin/health-check-and-recover.sh 8080
HealthStartPeriod=5s
HealthInterval=15s
HealthStartupTimeout=5s
HealthRetries=5
HealthOnFailure=kill

Volume=torrent-config.volume:/config
Volume=/var/mnt/s1/media:/share/Video
Volume=%h/.config/containers/qbittorrent/usr/local/bin/health-check-and-recover.sh:/usr/local/bin/health-check-and-recover.sh:ro
Network=public.network
