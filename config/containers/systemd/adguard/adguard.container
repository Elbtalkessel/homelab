[Unit]
Description=Adguard Home Server

[Install]
WantedBy=default.target

[Container]
ContainerName=adguard
Image=docker.io/adguard/adguardhome
Volume=adguard-work.volume:/opt/adguardhome/work
Volume=adguard-conf.volume:/opt/adguardhome/conf
PublishPort=192.168.8.130:53:53/tcp
PublishPort=192.168.8.130:53:53/udp
Network=public.network
