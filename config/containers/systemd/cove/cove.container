[Unit]
Description=Cove Media Organizer
Documentation=https://yourcove.net/docs/user/getting-started/install/
Requires=cove-db.service
After=cove-db.service
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=ghcr.io/yourcove/cove-app:latest
ContainerName=cove
AutoUpdate=registry
# The image hardcodes USER cove (uid 1000), which rootless podman maps to an
# unmapped subuid with no rights on the NFS exports under /var/mnt/s1. Map the
# process onto the podman user's uid instead so the host mounts are readable,
# the same identity that makes root-in-stash work. Same approach as immich.
UserNS=keep-id
User=%U:%U

# env
Environment=TZ=Etc/UTC
Environment=COVE__Postgres__Managed=false
# COVE__Postgres__ConnectionString is intentionally NOT set here. Cove needs the
# password embedded in the connection string, and systemd does not expand
# variables inside Environment=, so the whole string is delivered by the
# cove-db-connection-string secret instead.
Environment=COVE_HOME=/cove/config
Environment=COVE__GeneratedPath=/cove/generated
Environment=COVE__CachePath=/cove/cache
Environment=COVE__BackupPath=/cove/backups

# vol
Volume=/etc/localtime:/etc/localtime:ro
Volume=/var/mnt/s1/xyz:/data/legacy
Volume=/var/mnt/s1/media:/data/library
# :U chowns each volume to the container's primary user (%U). Podman seeds a fresh
# named volume with the image's VOLUME ownership, which is cove:cove (1000:1000),
# so without this the app volumes stay owned by 1000 and Cove cannot write
# /config once User=%U:%U remaps the process. Not applied to the NFS binds --
# those must never be chowned from the container.
Volume=cove-config.volume:/cove/config:U
Volume=cove-generated.volume:/cove/generated:U
Volume=cove-backups.volume:/cove/backups:U
Volume=cove-cache.volume:/cove/cache:U

# Value must be a full Npgsql connection string whose password matches the
# cove-db-password secret, e.g.
#   Host=cove-db;Port=5432;Database=cove;Username=cove;Password=<password>
Secret="cove-db-connection-string,type=env,target=COVE__Postgres__ConnectionString"

# chk (endpoint from the image's own HEALTHCHECK)
HealthCmd=CMD-SHELL curl -fsS http://localhost:5073/health || exit 1
HealthStartPeriod=30s
HealthInterval=30s
HealthStartupTimeout=5s
HealthRetries=3

# net
Network=public.network
Network=cove.network

# Intel VAAPI acceleration
AddDevice=/dev/dri:/dev/dri
