[Unit]
Description=Dnsmasq Local DNS Resolver
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=docker.io/drpsychick/dnsmasq:latest
ContainerName=dnsmasq
AutoUpdate=registry
Volume=%h/.config/containers/dnsmasq/dnsmasq.conf:/etc/dnsmasq.conf:ro,Z
# Bind it to 192.168.1.130, I've tried to bind it to 0.0.0.0 (by disabling systemd dns stub, see networking.yaml ansible task.
# Does work, but podman internal name resolution stopped working.
# Probably ideally is to host DNS in a separate VM, or better set DNS in router config.
PublishPort=192.168.1.130:53:53/tcp
PublishPort=192.168.1.130:53:53/udp
Network=public.network
