[Unit]
Description=An alternative server implementation of the Bitwarden Client API
Documentation=https://github.com/dani-garcia/vaultwarden/wiki
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

StartLimitIntervalSec=120
[Container]
Image=docker.io/vaultwarden/server:latest
ContainerName=vaultwarden
Environment=DOMAIN=https://vault.x.home.arpa
Secret=vaultwarden-admin-token,type=env,target=ADMIN_TOKEN
Volume=vaultwarden.volume:/data
Network=public.network
