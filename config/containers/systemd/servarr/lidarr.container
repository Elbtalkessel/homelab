[Unit]
Description=Music collection manager
Documentation=https://wiki.servarr.com/lidarr
Wants=torrent.service

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15
StartLimitBurst=5
StartLimitIntervalSec=120

[Container]
Image=lscr.io/linuxserver/lidarr:latest
AutoUpdate=registry
ContainerName=lidarr
Volume=lidarr-config.volume:/config
Volume=/var/mnt/s1/media:/share/Video
Environment=TZ=Etc/UTC
Environment=PUID=0
Environment=PGID=0
HealthCmd=CMD-SHELL curl --fail http://localhost:8686 || exit 1
HealthStartPeriod=10s
HealthInterval=5s
HealthStartupTimeout=5s
HealthRetries=5
Network=public.network
