[Unit]
Description=The Movie Collection Manager
Documentation=https://wiki.servarr.com/radarr
Wants=torrent.service
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=lscr.io/linuxserver/radarr:latest
AutoUpdate=registry
ContainerName=radarr
Volume=radarr-config.volume:/config
Volume=/var/mnt/s1/media:/share/Video
Environment=TZ=Etc/UTC
Environment=PUID=0
Environment=PGID=0
HealthCmd=CMD-SHELL curl --fail http://localhost:7878 || exit 1
HealthStartPeriod=10s
HealthInterval=5s
HealthStartupTimeout=5s
HealthRetries=5
Network=public.network
