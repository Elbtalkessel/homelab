[Unit]
Description=Bifrost LLM Gateway
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=docker.io/maximhq/bifrost:v2.2.6
ContainerName=bifrost
AutoUpdate=registry

# Data persistence
Volume=bifrost-data.volume:/app/data

# Bind to all interfaces inside container
Environment=APP_HOST=0.0.0.0
Environment=APP_PORT=8080
Secret="bifrost-setup-token,type=env,target=BIFROST_SETUP_TOKEN"

# Expose to Traefik via public network
Network=public.network

# Health check
HealthCmd=CMD-SHELL curl -fsS http://0.0.0.0:8080/health || exit 1
HealthStartPeriod=20s
HealthStartupTimeout=5s

