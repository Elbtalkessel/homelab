[Unit]
Description=An open source alternative front-end to YouTube
Documentation=https://docs.invidious.io
Requires=invidious-db.service
Wants=invidious-companion.service
StartLimitBurst=5
StartLimitIntervalSec=120

[Install]
WantedBy=default.target

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=quay.io/invidious/invidious:latest
AutoUpdate=registry
ContainerName=invidious
Environment=INVIDIOUS_CONFIG_FILE=/invidious/config.yml
Volume=%h/.config/containers/invidious/config.yml:/invidious/config.yml
HealthCmd=CMD-SHELL wget -nv --tries=1 --spider http://127.0.0.1:3000/search || exit 1
HealthInterval=30s
HealthStartupTimeout=5s
HealthRetries=2
Network=public.network
Network=invidious.network
