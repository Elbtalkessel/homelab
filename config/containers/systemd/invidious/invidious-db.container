[Unit]
Description=Invidious database service
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
Image=docker.io/library/postgres:14
AutoUpdate=registry
ContainerName=invidious-db
Volume=invidious-db-data.volume:/var/lib/postgresql/data
Volume=%h/.config/containers/invidious/db/config:/config:ro
Volume=%h/.config/containers/invidious/db/docker-entrypoint-initdb.d:/docker-entrypoint-initdb.d:ro
Environment=POSTGRES_DB=invidious
Environment=POSTGRES_USER=invidious
Environment=POSTGRES_PASSWORD=invidious
HealthCmd=CMD-SHELL pg_isready -U $POSTGRES_USER -d $POSTGRES_DB
Notify=healthy
Network=invidious.network
