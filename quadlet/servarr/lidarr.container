[Unit]
Description=Music collection manager

[Install]
WantedBy=default.target

[Container]
Image=lscr.io/linuxserver/lidarr:latest
ContainerName=lidarr
Volume=lidarr.volume:/config
Volume=/var/mnt/s1/media/Music:/share/Video/Music
Volume=/var/mnt/s1/media/Downloads:/share/Video/Downloads
Environment="PUID=1001"
Environment="PGID=1001"
Environment="TZ=Etc/UTC"
HealthCmd=CMD-SHELL curl --fail http://localhost:8686 || exit 1
HealthStartPeriod=10s
HealthInterval=5s
HealthStartupTimeout=5s
HealthRetries=5
Network=public.network

