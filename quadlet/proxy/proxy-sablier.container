[Unit]
Description=Sablier Scheduler
Requires=podman.socket

[Container]
Image=docker.io/acouvreur/sablier:1.3.0
PodmanArgs=--privileged
Exec=start --provider.name=docker --sessions.expiration-interval=15m --sessions.default-duration=1h
AutoUpdate=registry
Volume=/run/user/%U/podman/podman.sock:/var/run/docker.sock:z
Network=public

[Install]
WantedBy=default.target
