{{$proxies := list
  (dict "Service" "calibre"
        "Enable" false
	      "SessionDuration" "30m"
        "Port" 8083)

	(dict "Service" "dockge"
        "Enable" false
	      "Alias" "docker"
	      "SessionDuration" "30m"
        "Port" 5001)

	(dict "Service" "filebot"
        "Enable" false
        "Port" 5452)

	(dict "Service" "gitea"
        "Enable" false
	      "SessionDuration" "1h"
        "Port" 3000)

	(dict "Service" "immich"
        "Enable" false
	      "Alias" "photos"
        "Port" 2283
	      "SessionDuration" "3h"
        "Names" "immich,immich-ml,immich-redis")

	(dict "Service" "adminer"
        "Enable" false
        "Port" 8080)

	(dict "Service" "stash"
        "Enable" false
	      "Keepalive" true
        "Port" 9999)

	(dict "Service" "vaultwarden"
        "Enable" false
        "Port" 80
        "Keepalive" true
        "Alias" "vault")

	(dict "Service" "lidarr"
        "Enable" false
	      "Keepalive" true
        "Port" 8686)

	(dict "Service" "overseerr"
        "Enable" false
	      "SessionDuration" "1h"
        "Port" 5055)

	(dict "Service" "prowlarr"
        "Enable" false
	      "Keepalive" true
        "Port" 9696)

	(dict "Service" "radarr"
        "Enable" false
	      "Keepalive" true
        "Port" 7878)

	(dict "Service" "sonarr"
        "Enable" false
	      "Keepalive" true
        "Port" 8989)

	(dict "Service" "torrent"
        "Enable" false
	      "Keepalive" true
        "Port" 8080)

  (dict "Service" "glances"
        "Enable" false
        "HostNetwork" true
        "Port" 61209)

  (dict "Service" "invidious"
        "Enable" false
        "Alias" "yt"
        "Port" 3000
        "Keepalive" true)

  (dict "Service" "notifiarr"
        "Enable" false
        "Port" 5454
        "Keepalive" true)
}}

http:
  middlewares:
  {{range $proxies}}
  {{if .Enable}}
  {{if not .Keepalive }}
    {{.Service}}-sablier:
      plugin:
        sablier:
          {{if .Blocking}}
          blocking:
            defaultTimeout: 10s
          {{else}}
          dynamic:
            displayName: {{.Service}}
            refreshFrequency: 5s
            showDetails: true
            theme: shuffle
          {{end}}
          sablierUrl: http://sablier:10000
          sessionDuration: {{or .SessionDuration "10m"}}
          names: {{or .Names .Service}}
  {{end}}
  {{end}}
  {{end}}

  services:
  {{range $proxies}}
    {{if .Enable}}
    {{.Service}}:
      loadBalancer:
        {{if .HostNetwork}}
        passHostHeader: true
        {{end}}
        servers:
          {{if .HostNetwork}}
          - url: http://host.containers.internal:{{.Port}}
          {{else}}
          - url: http://{{.Service}}:{{.Port}}
          {{end}}
    {{end}}
  {{end}}

  routers:
  {{range $proxies}}
    {{if .Enable}}
    {{.Service}}:
      {{$domain := or .Alias .Service}}
      rule: "Host(`{{$domain}}.x.home.arpa`)"
      entryPoints:
        - websecure
      {{ if not .Keepalive }}
      middlewares:
        - {{.Service}}-sablier@file
      {{ end }}
      service: {{.Service}}
      tls:
        certresolver: ca
    {{end}}
  {{end}}
