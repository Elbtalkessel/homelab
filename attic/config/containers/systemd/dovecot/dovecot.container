[Unit]
Description=Dovecot IMAP Server
After=network-online.target

[Container]
Image=docker.io/dovecot/dovecot
ContainerName=dovecot
Network=public.network
PublishPort=143:143
Volume=./etc/dovecot.conf:/etc/dovecot/dovecot.conf:ro
Volume=mail-data.volume:/var/mail:z

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
