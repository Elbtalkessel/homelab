[Unit]
Description=Sablier Scheduler
Requires=podman.socket
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Restart=on-abnormal
RestartSec=15

[Container]
ContainerName=sablier
Image=docker.io/sablierapp/sablier:1.18.0
PodmanArgs=--privileged
Exec=start --provider.name=podman --sessions.expiration-interval=15m --sessions.default-duration=1h
AutoUpdate=registry
Volume=/run/user/%U/podman/podman.sock:/run/podman/podman.sock:z
Network=public.network

[Install]
WantedBy=default.target
